<UserControl x:Class="Portal.Views.FileListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Portal.ViewModels"
             x:Name="Root" AllowDrop="True"
             DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
             PreviewMouseDown="OnAnyMouseDown" GotKeyboardFocus="OnFocused">
    <Grid Background="{DynamicResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="ActiveBar" Height="2" VerticalAlignment="Top" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />

        <Grid Margin="8,8,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}" ToolTip="Up one level (Backspace)" AutomationProperties.Name="Up one level">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,8,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="{Binding TitleGlyph}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="2" x:Name="Crumbs" MinHeight="32" CornerRadius="4" BorderThickness="1" Cursor="IBeam"
                    Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    MouseLeftButtonUp="OnCrumbsClick" ToolTip="Click to type a path (Ctrl+L)">
                <Grid>
                    <DockPanel x:Name="CrumbScroll" SizeChanged="OnCrumbsSized" ClipToBounds="True" LastChildFill="False" Visibility="{Binding IsEditingPath, Converter={StaticResource Collapsed}}">
                        <TextBlock x:Name="CrumbEllipsis" DockPanel.Dock="Left" Text="…" Margin="8,0,2,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" ToolTip="{Binding Path}" />
                        <ItemsControl x:Name="CrumbItems" DockPanel.Dock="Left" ItemsSource="{Binding Breadcrumbs}" Margin="2,0" VerticalAlignment="Center" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="8" Margin="2,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Button Style="{StaticResource SubtleButton}" Padding="6,0" MinHeight="26" Content="{Binding Label}" Cursor="Arrow"
                                                Command="{Binding DataContext.GoToCommand, ElementName=Root}" CommandParameter="{Binding Path}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                            <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <TextBox x:Name="PathBox" Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalContentAlignment="Center" Padding="8,0"
                             Visibility="{Binding IsEditingPath, Converter={StaticResource Visible}}" AutomationProperties.Name="Path"
                             KeyDown="OnPathKey" LostKeyboardFocus="OnPathLostFocus" IsVisibleChanged="OnPathVisible" />
                </Grid>
            </Border>

            <Grid Grid.Column="3" Width="180" Margin="8,0,0,0">
                <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="28,0,8,0" VerticalContentAlignment="Center" MinHeight="32"
                         AutomationProperties.Name="Filter" KeyDown="OnFilterKey" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" FontSize="12" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsHitTestVisible="False" />
                <TextBlock Text="{Binding FilterPlaceholder}" Style="{StaticResource Faint}" Margin="30,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource VisibleIfSet}, ConverterParameter=invert}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <DataGrid x:Name="Grid" ItemsSource="{Binding View}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                      SelectionMode="Extended" SelectionUnit="FullRow" CanUserResizeRows="False" CanUserReorderColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      RowHeight="32" BorderThickness="0" Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                      SelectionChanged="OnSelectionChanged" Sorting="OnSorting" MouseDoubleClick="OnDoubleClick" PreviewKeyDown="OnGridKey"
                      PreviewMouseLeftButtonDown="OnGridMouseDown" PreviewMouseLeftButtonUp="OnGridMouseUp" PreviewMouseMove="OnGridMouseMove"
                      ContextMenuOpening="OnContextMenuOpening" AutomationProperties.Name="{Binding Title, StringFormat={}{0} files}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Margin="4,1" BorderThickness="1" BorderBrush="Transparent">
                                        <Grid>
                                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                            <SelectiveScrollingGrid>
                                                <SelectiveScrollingGrid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </SelectiveScrollingGrid.ColumnDefinitions>
                                                <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                            </SelectiveScrollingGrid>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionFillBrush}" />
                                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <ContentPresenter VerticalAlignment="Center" Margin="8,0" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu />
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="*" MinWidth="160" SortDirection="Ascending">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:EntryViewModel}">
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" HorizontalAlignment="Left" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsRenaming, Converter={StaticResource Collapsed}}" />
                                    <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="6,0" VerticalContentAlignment="Center"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource Visible}}" AutomationProperties.Name="New name"
                                             IsVisibleChanged="OnRenameVisible" KeyDown="OnRenameKey" LostKeyboardFocus="OnRenameLostFocus" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource FolderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                        <Setter TargetName="Label" Property="Opacity" Value="0.6" />
                                        <Setter TargetName="Glyph" Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Modified" SortMemberPath="Modified" Width="132">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:EntryViewModel}">
                                <TextBlock Text="{Binding ModifiedText}" ToolTip="{Binding ModifiedTooltip}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Size" SortMemberPath="Size" Width="84">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:EntryViewModel}">
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="PermissionsColumn" Header="Permissions" SortMemberPath="Permissions" Width="124">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:EntryViewModel}">
                                <TextBlock Text="{Binding ModeText}" ToolTip="{Binding ModeTooltip}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="OwnerColumn" Header="Owner" SortMemberPath="Owner" Width="92">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:EntryViewModel}">
                                <TextBlock Text="{Binding Owner}" ToolTip="{Binding Group, StringFormat=Group: {0}}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="2" MinHeight="2" Margin="0,32,0,0" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320" IsHitTestVisible="True" Visibility="{Binding ShowEmpty, Converter={StaticResource Visible}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12" />
                <TextBlock Text="{Binding EmptyTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                <Button Content="Clear filter" Command="{Binding ClearFilterCommand}" HorizontalAlignment="Center" Margin="0,12,0,0"
                        Visibility="{Binding Filter, Converter={StaticResource VisibleIfSet}}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Visibility="{Binding LoadError, Converter={StaticResource VisibleIfSet}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="32" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,0,12" />
                <TextBlock Text="{Binding LoadError}" TextAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Content="Try again" Command="{Binding RefreshCommand}" />
                    <Button Content="Go up" Command="{Binding GoUpCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <Grid x:Name="DropOverlay" Margin="8" Visibility="Collapsed" IsHitTestVisible="False">
                <Border CornerRadius="8" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.12" />
                <Border CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock x:Name="DropText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="16,6">
            <TextBlock Text="{Binding FooterText}" Style="{StaticResource Faint}" />
        </Border>
    </Grid>
</UserControl>
