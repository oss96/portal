<UserControl x:Class="Portal.Views.ConnectingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Portal.ViewModels"
             x:Name="Root">
    <UserControl.InputBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <DataTemplate x:Key="ServerItem" DataType="{x:Type vm:SidebarItem}">
            <Button x:Name="Btn" Style="{StaticResource NavButton}" Command="{Binding DataContext.OpenServerCommand, ElementName=Root}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Label}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Marker" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,0,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" HorizontalAlignment="Left" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Ellipse x:Name="Dot" Grid.Column="2" Width="8" Height="8" Fill="{DynamicResource SystemFillColorSuccessBrush}" Visibility="Collapsed" Margin="8,0,0,0" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Btn" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="8,6">
            <Grid MinHeight="36" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource LayerFillColorAltBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,8">
                    <StackPanel>
                        <TextBlock Text="Servers" Style="{StaticResource SectionHeader}" Margin="12,4,12,4" />
                        <ItemsControl ItemsSource="{Binding Servers}" ItemTemplate="{StaticResource ServerItem}" Focusable="False" />
                        <Button Style="{StaticResource NavButton}" Command="{Binding AddServerCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Width="28" HorizontalAlignment="Left" TextAlignment="Left" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Add server" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <Border Grid.Column="2" Background="{DynamicResource LayerFillColorDefaultBrush}">
                <StackPanel DataContext="{Binding Card}" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <Border Width="48" Height="48" CornerRadius="8" HorizontalAlignment="Left" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8CE;" FontSize="24" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="{Binding DataContext.ConnectingText, ElementName=Root}" FontSize="{StaticResource SubtitleSize}" FontWeight="SemiBold" Margin="0,16,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding ErrorTitle}" FontSize="{StaticResource SubtitleSize}" FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding Profile.Address}" Style="{StaticResource Caption}" Margin="0,2,0,0" />

                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,16,0,0" Focusable="False" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                    <Button Content="Cancel" Command="{Binding DataContext.CancelCommand, ElementName=Root}" MinWidth="96" HorizontalAlignment="Left" Margin="0,16,0,0"
                            AutomationProperties.Name="{Binding Title, StringFormat=Cancel connecting to {0}}"
                            Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />

                    <StackPanel Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                        <TextBox Text="{Binding ErrorDetail, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap" Margin="0,12,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Try again" Command="{Binding ConnectCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="96" />
                            <Button Content="Edit server" Command="{Binding DataContext.EditServerCommand, ElementName=Root}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="12,0" Height="32">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" MinHeight="24" Padding="8,0" Command="{Binding OpenSettingsCommand}" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Settings" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding Card}">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding DataContext.ConnectingText, ElementName=Root, StringFormat={}{0}…}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Text" Value="{Binding Title, StringFormat=Not connected to {0}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
