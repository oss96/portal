<UserControl x:Class="Portal.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Portal.ViewModels"
             xmlns:local="clr-namespace:Portal"
             xmlns:conn="clr-namespace:Portal.Core.Connections;assembly=Portal.Core">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="56,40,56,40" MaxWidth="680" HorizontalAlignment="Left">
                <Button Style="{StaticResource SubtleButton}" Command="{Binding GoBackCommand}" HorizontalAlignment="Left" Margin="-10,0,0,16"
                        Visibility="{Binding CanGoBack, Converter={StaticResource Visible}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Back to files" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Your servers" Style="{StaticResource Title}" />
                <TextBlock Margin="0,4,0,32" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Pick a server to browse and manage its files. Portal signs in with your SSH keys and checks each server’s identity before it connects." />

                <Border Style="{StaticResource Card}" Padding="24" Visibility="{Binding HasNoServers, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="No servers yet" FontWeight="SemiBold" />
                        <TextBlock Text="Add one with the form on the right, or pick a host from your SSH config below." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ServerCardViewModel}">
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8CE;" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Command="{Binding EditCommand}" ToolTip="Edit" AutomationProperties.Name="{Binding Title, StringFormat=Edit {0}}"
                                                Visibility="{Binding IsIdle, Converter={StaticResource Visible}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="14" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Command="{Binding RemoveCommand}" ToolTip="Remove" AutomationProperties.Name="{Binding Title, StringFormat=Remove {0}}" Margin="0,0,8,0"
                                                Visibility="{Binding IsIdle, Converter={StaticResource Visible}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" />
                                        </Button>
                                        <Button Content="{Binding ConnectText}" Command="{Binding ConnectCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="96"
                                                AutomationProperties.Name="{Binding Title, StringFormat=Connect to {0}}"
                                                Visibility="{Binding IsIdle, Converter={StaticResource Visible}}" />
                                        <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="96" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                                    </StackPanel>

                                    <ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Steps}" Margin="16,12,0,0" Focusable="False"
                                                  Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ConnectStepViewModel}">
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Grid Width="16" Margin="0,0,8,0">
                                                        <TextBlock x:Name="Done" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                                                        <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="12" Height="12" MinHeight="0" Visibility="Collapsed" />
                                                    </Grid>
                                                    <TextBlock x:Name="Label" Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Done">
                                                        <Setter TargetName="Done" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Active">
                                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="16,12,0,0" Padding="12,10" CornerRadius="4"
                                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" VerticalAlignment="Top" Margin="0,2,10,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding ErrorTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBox Text="{Binding ErrorDetail, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Try again" Command="{Binding ConnectCommand}" />
                                                    <Button Content="Edit server" Command="{Binding EditCommand}" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,16,0,0" Visibility="{Binding ConfigAliases, Converter={StaticResource VisibleIfSet}}">
                    <TextBlock Text="Found in your SSH config" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding ConfigAliases}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.UseAliasCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="0,0,8,8"
                                        Padding="12,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,40">
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Subtitle}" Margin="0,0,0,20" />
                    <TextBlock Text="Address" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                    <TextBox x:Name="HostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Address" KeyDown="OnFormKey" />
                    <TextBlock Text="An IP address, a host name, or a name from your SSH config." Style="{StaticResource Faint}" Margin="0,4,0,16" TextWrapping="Wrap" />
                    <TextBlock Text="Name in Portal (optional)" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Name in Portal" Margin="0,0,0,16" KeyDown="OnFormKey" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="User (optional)" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="User" KeyDown="OnFormKey" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Port" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Port" KeyDown="OnFormKey" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Sign in with" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                    <StackPanel Margin="0,0,0,4">
                        <RadioButton Content="My SSH keys" GroupName="Auth" IsChecked="{Binding Auth, Converter={x:Static local:EnumMatch.Instance}, ConverterParameter={x:Static conn:AuthKind.DefaultKeys}}" />
                        <RadioButton Content="A key file" GroupName="Auth" IsChecked="{Binding Auth, Converter={x:Static local:EnumMatch.Instance}, ConverterParameter={x:Static conn:AuthKind.KeyFile}}" />
                        <RadioButton Content="A password" GroupName="Auth" IsChecked="{Binding Auth, Converter={x:Static local:EnumMatch.Instance}, ConverterParameter={x:Static conn:AuthKind.Password}}" />
                    </StackPanel>
                    <DockPanel Margin="0,4,0,0" Visibility="{Binding UsesKeyFile, Converter={StaticResource Visible}}">
                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding ChooseKeyFileCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding KeyFile, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Key file" />
                    </DockPanel>
                    <TextBlock Text="{Binding AuthHint}" Style="{StaticResource Faint}" Margin="0,6,0,16" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding FormError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                               Visibility="{Binding FormError, Converter={StaticResource VisibleIfSet}}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding SaveText}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Style="{DynamicResource AccentButtonStyle}" MinWidth="140" />
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}" Margin="8,0,0,0" Visibility="{Binding IsEditing, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
