<Window x:Class="Portal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Portal.ViewModels"
        xmlns:views="clr-namespace:Portal.Views"
        xmlns:services="clr-namespace:Portal.Services"
        Title="{Binding Title}"
        Icon="Assets/icon.png"
        Width="1280" Height="800" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ConnectViewModel}">
            <views:ConnectView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BrowserViewModel}">
            <views:BrowserView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding Current}" Focusable="False" />

        <ItemsControl ItemsSource="{Binding Toasts.Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,16,48" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type services:ToastViewModel}">
                    <Border Width="360" Margin="0,8,0,0" Padding="16,12" CornerRadius="8"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                            AutomationProperties.LiveSetting="Polite">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.28" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" VerticalAlignment="Top" Margin="0,2,12,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Body}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Visibility="{Binding Body, Converter={StaticResource VisibleIfSet}}" />
                                <Button Content="{Binding ActionLabel}" Command="{Binding ActCommand}" Style="{StaticResource LinkButton}" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Left"
                                        Visibility="{Binding ActionLabel, Converter={StaticResource VisibleIfSet}}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24" Margin="8,-4,-8,0" VerticalAlignment="Top"
                                    Command="{Binding CloseCommand}" ToolTip="Close" AutomationProperties.Name="Close notification">
                                <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE711;" />
                            </Button>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Success">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid x:Name="PaletteLayer" Background="Transparent" Visibility="{Binding Palette, Converter={StaticResource VisibleIfSet}}" MouseDown="OnPaletteBackdrop">
            <Border DataContext="{Binding Palette}" Width="580" VerticalAlignment="Top" Margin="0,56,0,0" CornerRadius="8"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.32" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="8,8,8,4">
                        <TextBox x:Name="PaletteInput" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="36,8,10,8"
                                 PreviewKeyDown="OnPaletteKey" AutomationProperties.Name="Search commands and files" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" HorizontalAlignment="Left" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsHitTestVisible="False" />
                        <TextBlock Text="{Binding Placeholder}" Style="{StaticResource Faint}" FontSize="14" Margin="38,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=PaletteInput, Converter={StaticResource VisibleIfSet}, ConverterParameter=invert}" x:Name="PalettePlaceholder" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" MaxHeight="360" Margin="4,0,4,8" BorderThickness="0" Background="Transparent"
                             MouseUp="OnPaletteClick" KeyboardNavigation.TabNavigation="None">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PaletteItem}">
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" HorizontalAlignment="Left" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Hint}" Style="{StaticResource Faint}" VerticalAlignment="Center" MaxWidth="260" Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Searching the server…" Style="{StaticResource Faint}" Margin="16,0,16,12" Visibility="{Binding IsSearching, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Background="{DynamicResource SmokeFillColorDefaultBrush}" Visibility="{Binding Dialogs.Current, Converter={StaticResource VisibleIfSet}}" MouseDown="OnDialogBackdrop">
            <Border MinWidth="448" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                    MouseDown="OnDialogSurface" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.35" />
                </Border.Effect>
                <ContentControl x:Name="DialogContent" Content="{Binding Dialogs.Current}" Focusable="False" />
            </Border>
        </Grid>
    </Grid>
</Window>
